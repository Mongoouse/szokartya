# --- Adatbázis -----------------------------------------------------------------
# PostgreSQL kapcsolat (a gyökérkönyvtári docker-compose.yml alapértékeivel egyezik)
DATABASE_URL="postgresql://szokartya:szokartya@localhost:5432/szokartya?schema=public"

# --- HTTP ----------------------------------------------------------------------
PORT=3000
# Vesszővel elválasztott engedélyezett CORS originök (üres = CORS kikapcsolva)
CORS_ORIGINS=""

# --- Hitelesítés ---------------------------------------------------------------
# Legalább 32 karakteres véletlen titok, pl.: openssl rand -base64 48
JWT_ACCESS_SECRET="change-me-to-a-long-random-secret-of-at-least-32-chars"
# Access token élettartama másodpercben (alapértelmezés: 15 perc)
JWT_ACCESS_TTL_SECONDS=900
# Refresh token élettartama napokban
REFRESH_TOKEN_TTL_DAYS=30

# Rate limit (csak tesztkörnyezetben kapcsold ki)
THROTTLE_ENABLED=true

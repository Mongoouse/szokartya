// =============================================================================
// Szókártya – relációs adatmodell (PostgreSQL 16, Prisma ORM)
// =============================================================================
//
// Konvenciók
//   * Elsődleges kulcs: UUID. A kliens offline is generálhat azonosítót, így a
//     szinkronizáció során nincs kulcsütközés és nincs szükség ID-újraosztásra.
//   * Fizikai nevek: snake_case (@map / @@map), a TypeScript oldalon camelCase.
//   * Időbélyegek: timestamptz(3). Az `updated_at` mezőt DB-trigger tartja
//     karban (lásd 2. migráció), így a nyers SQL-ből érkező módosítások is
//     helyes szinkron-időbélyeget kapnak.
//   * Szinkronizált táblák: `deleted_at` (soft delete / tombstone) és `version`
//     (optimista konkurenciakezelés, triggerrel növelve).
//
// A Prisma séma nyelvén NEM kifejezhető objektumok (CHECK kényszerek, részleges
// és GIN indexek, NULLS NOT DISTINCT, triggerek, kiterjesztések) a
// `migrations/*_constraints_indexes/migration.sql` fájlban találhatók; a
// modelleknél `[SQL]` megjegyzés jelzi őket.
// =============================================================================

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [citext, pg_trgm, pgcrypto]
}

// -----------------------------------------------------------------------------
// Enumok
// -----------------------------------------------------------------------------

/// Közös Európai Referenciakeret szintjei.
enum CefrLevel {
  A1
  A2
  B1
  B2
  C1
  C2

  @@map("cefr_level")
}

enum PartOfSpeech {
  NOUN
  VERB
  ADJECTIVE
  ADVERB
  PREPOSITION
  CONJUNCTION
  PRONOUN
  PHRASE
  OTHER

  @@map("part_of_speech")
}

/// Nyelvtani nem – a névelő ebből származtatható (der / die / das).
enum GrammaticalGender {
  MASCULINE
  FEMININE
  NEUTER

  @@map("grammatical_gender")
}

/// Főnév számbeli viselkedése.
enum NumberType {
  REGULAR //       van egyes és többes szám (der Tisch – die Tische)
  SINGULAR_ONLY // Singularetantum (die Milch)
  PLURAL_ONLY //   Pluraletantum (die Leute)

  @@map("number_type")
}

enum ConjugationType {
  REGULAR //   gyenge (machen – machte – gemacht)
  IRREGULAR // erős (gehen – ging – gegangen)
  MIXED //     vegyes (denken – dachte – gedacht)

  @@map("conjugation_type")
}

/// Perfekt segédige.
enum AuxiliaryVerb {
  HABEN
  SEIN
  BOTH // pl. fahren: „ich habe das Auto gefahren” / „ich bin gefahren”

  @@map("auxiliary_verb")
}

enum ReflexiveType {
  NONE
  ACCUSATIVE // sich freuen
  DATIVE //     sich etwas vorstellen

  @@map("reflexive_type")
}

enum GrammaticalCase {
  NOMINATIVE
  ACCUSATIVE
  DATIVE
  GENITIVE

  @@map("grammatical_case")
}

/// Egy szóból több, egymástól függetlenül ütemezett kártya képezhető.
enum CardType {
  RECOGNITION // német → magyar (felismerés)
  PRODUCTION //  magyar → német (felidézés)
  GENDER //      névelő gyakorlása (csak főneveknél értelmes)
  PLURAL //      többes szám: der Tisch → die Tische (csak megszámlálható főnévnél)
  VERB_FORMS //  igei alapalakok: fahren → fährt – fuhr – ist gefahren
  VALENCY //     vonzat: warten ___ + Akk. → auf (csak vonzatos szónál)

  @@map("card_type")
}

/// Az SM-2 alapú ütemező állapotgépe.
enum CardState {
  NEW
  LEARNING
  REVIEW
  RELEARNING

  @@map("card_state")
}

// -----------------------------------------------------------------------------
// Felhasználók és munkamenetek
// -----------------------------------------------------------------------------

model User {
  id                 String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// citext: kis-/nagybetű-független egyediség (a@x.hu == A@X.hu) alkalmazáslogika nélkül.
  email              String      @unique @db.Citext
  /// argon2id hash (PHC string formátum, a paramétereket is tartalmazza).
  passwordHash       String      @map("password_hash") @db.VarChar(255)
  displayName        String?     @map("display_name") @db.VarChar(100)
  /// ISO 639-1 kód.
  nativeLanguage     String      @default("hu") @map("native_language") @db.VarChar(8)
  /// IANA időzóna – a „mai esedékes kártyák” napfordulójának meghatározásához.
  timezone           String      @default("Europe/Budapest") @db.VarChar(64)
  dailyNewCardsLimit Int         @default(20) @map("daily_new_cards_limit") @db.SmallInt
  dailyReviewLimit   Int         @default(200) @map("daily_review_limit") @db.SmallInt
  /// Cél felidézési valószínűség az esedékességkor (0.70–0.97). Magasabb érték
  /// → rövidebb intervallumok, több ismétlés; az ütemező ebből skálázza az
  /// ismétlési intervallumot (lásd sm2-scheduler: retentionIntervalFactor).
  targetRetention    Decimal     @default(0.90) @map("target_retention") @db.Decimal(3, 2)
  /// A szinkronizált központi szókatalógus CEFR szintjei; üres = mind.
  /// A saját és a már felvett szavak szinttől függetlenül szinkronizálódnak.
  catalogLevels      CefrLevel[] @default([]) @map("catalog_levels")
  createdAt          DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime    @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt          DateTime?   @map("deleted_at") @db.Timestamptz(3)

  refreshTokens RefreshToken[]
  ownedWords    Word[]         @relation("WordOwner")
  progress      UserProgress[]
  reviewLogs    ReviewLog[]

  // [SQL] CHECK: email formátum, napi limitek tartománya, target_retention tartománya.
  @@map("users")
}

/// Refresh token rotáció „token family” mintával: minden frissítéskor új token
/// keletkezik ugyanabban a családban; egy már lecserélt token újbóli
/// felhasználása lopásra utal → a teljes család visszavonható.
model RefreshToken {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId       String    @map("user_id") @db.Uuid
  /// A nyers token SHA-256 hash-e (hex). A nyers token soha nem kerül tárolásra.
  tokenHash    String    @unique @map("token_hash") @db.Char(64)
  familyId     String    @map("family_id") @db.Uuid
  replacedById String?   @unique @map("replaced_by_id") @db.Uuid
  /// Kliens által generált stabil eszközazonosító (több eszközös szinkronhoz).
  deviceId     String?   @map("device_id") @db.VarChar(128)
  userAgent    String?   @map("user_agent") @db.VarChar(512)
  ipAddress    String?   @map("ip_address") @db.Inet
  expiresAt    DateTime  @map("expires_at") @db.Timestamptz(3)
  revokedAt    DateTime? @map("revoked_at") @db.Timestamptz(3)
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  user       User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  replacedBy RefreshToken? @relation("TokenRotation", fields: [replacedById], references: [id], onDelete: SetNull)
  replaces   RefreshToken? @relation("TokenRotation")

  @@index([userId])
  @@index([familyId])
  /// Lejárt tokenek ütemezett takarításához.
  @@index([expiresAt])
  // [SQL] CHECK: expires_at > created_at.
  @@map("refresh_tokens")
}

// -----------------------------------------------------------------------------
// Szókincs
// -----------------------------------------------------------------------------

model Word {
  id            String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// Forrásnyelv (ISO 639-1). Jelenleg „de”, de a modell nem német-specifikus.
  language      String       @default("de") @db.VarChar(8)
  /// Szótári alak névelő nélkül (Tisch, warten, schnell).
  lemma         String       @db.VarChar(200)
  partOfSpeech  PartOfSpeech @map("part_of_speech")
  /// Azonos alakú, azonos szófajú, de eltérő jelentésű szavak sorszáma
  /// (der See ‘tó’ = 1, die See ‘tenger’ = 2).
  homographNo   Int          @default(1) @map("homograph_no") @db.SmallInt
  cefrLevel     CefrLevel?   @map("cefr_level")
  /// IPA átírás, pl. [tɪʃ].
  ipa           String?      @db.VarChar(200)
  audioUrl      String?      @map("audio_url") @db.VarChar(1024)
  /// Gyakorisági rang (1 = leggyakoribb) – új kártyák sorrendjéhez.
  frequencyRank Int?         @map("frequency_rank")
  /// NULL = központi (kurált) szótár; egyébként a felhasználó saját szava.
  ownerId       String?      @map("owner_id") @db.Uuid
  version       Int          @default(1)
  createdAt     DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime     @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt     DateTime?    @map("deleted_at") @db.Timestamptz(3)

  owner               User?                @relation("WordOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  nounAttributes      NounAttributes?
  verbAttributes      VerbAttributes?
  adjectiveAttributes AdjectiveAttributes?
  translations        Translation[]
  valencies           Valency[]
  examples            ExampleSentence[]
  categories          WordCategory[]
  progress            UserProgress[]

  /// A szófaji altáblák kompozit FK-jának célja: (id, part_of_speech).
  @@unique([id, partOfSpeech])
  /// [SQL] a migráció NULLS NOT DISTINCT-re cseréli, hogy a központi szótárban
  /// (owner_id IS NULL) is érvényesüljön az egyediség.
  @@unique([ownerId, language, lemma, partOfSpeech, homographNo], map: "words_identity_key")
  @@index([language, cefrLevel, partOfSpeech])
  @@index([updatedAt])
  /// Részleges egyezéses keresés (ILIKE '%…%', similarity) trigram GIN indexszel.
  @@index([lemma(ops: raw("gin_trgm_ops"))], map: "words_lemma_trgm_idx", type: Gin)
  // [SQL] CHECK: homograph_no >= 1, lemma nem üres, frequency_rank > 0.
  @@map("words")
}

/// Főnévi nyelvtani attribútumok (1:1 a `words` táblával).
model NounAttributes {
  wordId           String             @id @map("word_id") @db.Uuid
  /// Mindig NOUN – [SQL] CHECK biztosítja; a kompozit FK része.
  partOfSpeech     PartOfSpeech       @default(NOUN) @map("part_of_speech")
  gender           GrammaticalGender?
  numberType       NumberType         @default(REGULAR) @map("number_type")
  /// Többes számú alak névelő nélkül (Tische). NULL, ha SINGULAR_ONLY.
  pluralForm       String?            @map("plural_form") @db.VarChar(200)
  /// Egyes szám birtokos eset (des Tisches).
  genitiveSingular String?            @map("genitive_singular") @db.VarChar(200)
  /// Gyenge (n-)deklináció: der Student – den Studenten.
  isNDeclension    Boolean            @default(false) @map("is_n_declension")

  word Word @relation(fields: [wordId, partOfSpeech], references: [id, partOfSpeech], onDelete: Cascade, onUpdate: Restrict)

  @@unique([wordId, partOfSpeech])
  // [SQL] CHECK: part_of_speech = 'NOUN';
  //       number_type = 'PLURAL_ONLY' <=> gender IS NULL;
  //       number_type = 'SINGULAR_ONLY' => plural_form IS NULL;
  //       number_type = 'REGULAR' => plural_form IS NOT NULL.
  @@map("noun_attributes")
}

/// Igei nyelvtani attribútumok (1:1 a `words` táblával).
model VerbAttributes {
  wordId          String          @id @map("word_id") @db.Uuid
  partOfSpeech    PartOfSpeech    @default(VERB) @map("part_of_speech")
  conjugationType ConjugationType @map("conjugation_type")
  auxiliary       AuxiliaryVerb
  /// Jelen idő E/3 – a tőhangváltás miatt külön tárolva (er fährt).
  present3sg      String          @map("present_3sg") @db.VarChar(200)
  /// Präteritum E/3 (fuhr).
  preterite3sg    String          @map("preterite_3sg") @db.VarChar(200)
  /// Partizip II (gefahren).
  pastParticiple  String          @map("past_participle") @db.VarChar(200)
  isSeparable     Boolean         @default(false) @map("is_separable")
  /// Elváló igekötő (an-, auf-, ab-…). Csak is_separable = true esetén.
  separablePrefix String?         @map("separable_prefix") @db.VarChar(20)
  reflexiveType   ReflexiveType   @default(NONE) @map("reflexive_type")

  word Word @relation(fields: [wordId, partOfSpeech], references: [id, partOfSpeech], onDelete: Cascade, onUpdate: Restrict)

  @@unique([wordId, partOfSpeech])
  // [SQL] CHECK: part_of_speech = 'VERB';
  //       is_separable <=> separable_prefix IS NOT NULL.
  @@map("verb_attributes")
}

/// Melléknévi nyelvtani attribútumok (1:1 a `words` táblával).
model AdjectiveAttributes {
  wordId                String       @id @map("word_id") @db.Uuid
  partOfSpeech          PartOfSpeech @default(ADJECTIVE) @map("part_of_speech")
  /// Középfok (schneller, besser). NULL, ha nem fokozható (tot).
  comparative           String?      @db.VarChar(200)
  /// Felsőfok „am …-sten” alakban (am schnellsten, am besten).
  superlative           String?      @db.VarChar(200)
  isIrregularComparison Boolean      @default(false) @map("is_irregular_comparison")
  /// Csak állítmányként használható (pl. schuld, egal).
  isPredicativeOnly     Boolean      @default(false) @map("is_predicative_only")

  word Word @relation(fields: [wordId, partOfSpeech], references: [id, partOfSpeech], onDelete: Cascade, onUpdate: Restrict)

  @@unique([wordId, partOfSpeech])
  // [SQL] CHECK: part_of_speech = 'ADJECTIVE';
  //       comparative és superlative együtt NULL vagy együtt kitöltött.
  @@map("adjective_attributes")
}

/// Kötelező vonzat (Rektion): warten auf + Akk., abhängen von + Dat., helfen + Dat.
model Valency {
  id           String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  wordId       String          @map("word_id") @db.Uuid
  /// NULL = elöljáró nélküli esetvonzat (helfen + Dat.).
  preposition  String?         @db.VarChar(30)
  governedCase GrammaticalCase @map("governed_case")
  /// Visszaható szerkezet része-e (sich freuen auf + Akk.).
  isReflexive  Boolean         @default(false) @map("is_reflexive")
  /// Megjelenítési minta, pl. „warten auf + Akk.”.
  pattern      String          @db.VarChar(200)
  /// A vonzatos szerkezet magyar jelentése (vár valakire/valamire).
  meaning      String?         @db.VarChar(300)
  sortOrder    Int             @default(0) @map("sort_order") @db.SmallInt
  version      Int             @default(1)
  createdAt    DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime        @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt    DateTime?       @map("deleted_at") @db.Timestamptz(3)

  word     Word              @relation(fields: [wordId], references: [id], onDelete: Cascade)
  examples ExampleSentence[]

  @@index([wordId])
  // [SQL] UNIQUE NULLS NOT DISTINCT (word_id, preposition, governed_case, is_reflexive).
  // [SQL] CHECK: elöljárós vonzat nem lehet NOMINATIVE.
  @@map("valencies")
}

/// Jelentés a célnyelven. Egy szónak több jelentése / fordítása lehet.
model Translation {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  wordId    String    @map("word_id") @db.Uuid
  /// Célnyelv (ISO 639-1), alapértelmezés: magyar.
  language  String    @default("hu") @db.VarChar(8)
  text      String    @db.VarChar(300)
  /// Jelentésárnyalat / használati megjegyzés (pl. „bútor”, „átv.”).
  senseNote String?   @map("sense_note") @db.VarChar(300)
  /// A kártya hátoldalán elsődlegesen megjelenő fordítás.
  isPrimary Boolean   @default(false) @map("is_primary")
  sortOrder Int       @default(0) @map("sort_order") @db.SmallInt
  version   Int       @default(1)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(3)

  word Word @relation(fields: [wordId], references: [id], onDelete: Cascade)

  @@unique([wordId, language, text])
  // [SQL] részleges UNIQUE: (word_id, language) WHERE is_primary AND deleted_at IS NULL.
  /// Magyar → német keresés trigram GIN indexszel.
  @@index([text(ops: raw("gin_trgm_ops"))], map: "translations_text_trgm_idx", type: Gin)
  @@map("translations")
}

/// Példamondat kontextussal; opcionálisan egy konkrét vonzatot illusztrál.
model ExampleSentence {
  id          String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  wordId      String     @map("word_id") @db.Uuid
  valencyId   String?    @map("valency_id") @db.Uuid
  /// Forrásnyelvi mondat (de).
  sentence    String     @db.VarChar(1000)
  /// Célnyelvi fordítás (hu).
  translation String?    @db.VarChar(1000)
  cefrLevel   CefrLevel? @map("cefr_level")
  sortOrder   Int        @default(0) @map("sort_order") @db.SmallInt
  version     Int        @default(1)
  createdAt   DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime   @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt   DateTime?  @map("deleted_at") @db.Timestamptz(3)

  word    Word     @relation(fields: [wordId], references: [id], onDelete: Cascade)
  valency Valency? @relation(fields: [valencyId], references: [id], onDelete: SetNull)

  @@index([wordId])
  @@index([valencyId])
  @@map("example_sentences")
}

/// Hierarchikus tematikus kategória (Haushalt › Möbel).
model Category {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  slug      String   @unique @db.VarChar(100)
  nameHu    String   @map("name_hu") @db.VarChar(100)
  nameDe    String   @map("name_de") @db.VarChar(100)
  parentId  String?  @map("parent_id") @db.Uuid
  sortOrder Int      @default(0) @map("sort_order") @db.SmallInt
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  parent   Category?      @relation("CategoryTree", fields: [parentId], references: [id], onDelete: Restrict)
  children Category[]     @relation("CategoryTree")
  words    WordCategory[]

  @@index([parentId])
  // [SQL] CHECK: parent_id <> id; slug formátum.
  @@map("categories")
}

/// N:M kapcsolótábla szavak és kategóriák között.
model WordCategory {
  wordId     String @map("word_id") @db.Uuid
  categoryId String @map("category_id") @db.Uuid

  word     Word     @relation(fields: [wordId], references: [id], onDelete: Cascade)
  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([wordId, categoryId])
  /// Fordított irányú index: „egy kategória összes szava”.
  @@index([categoryId, wordId])
  @@map("word_categories")
}

// -----------------------------------------------------------------------------
// Tanulási előrehaladás és naplózás
// -----------------------------------------------------------------------------

/// Egy felhasználó egy kártyájának (szó × kártyatípus) aktuális ütemezési
/// állapota. A `review_logs` eseményeinek materializált pillanatképe.
model UserProgress {
  id       String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId   String    @map("user_id") @db.Uuid
  wordId   String    @map("word_id") @db.Uuid
  cardType CardType  @default(RECOGNITION) @map("card_type")
  state    CardState @default(NEW)

  // --- SM-2 paraméterek ---------------------------------------------------
  /// Nehézségi faktor (EF). SM-2: kezdetben 2.5, alsó korlát 1.3.
  easeFactor   Decimal @default(2.50) @map("ease_factor") @db.Decimal(4, 2)
  /// Aktuális ismétlési intervallum napokban (tanulási fázisban 0).
  intervalDays Int     @default(0) @map("interval_days")
  /// Egymást követő sikeres felidézések száma (SM-2 „n”). Hibánál nullázódik.
  repetitions  Int     @default(0)
  /// Tanulási / újratanulási lépcső indexe (perc alapú lépcsők, pl. 1m, 10m).
  learningStep Int     @default(0) @map("learning_step") @db.SmallInt

  // --- Statisztikai metrikák ---------------------------------------------
  /// Felejtések száma (REVIEW állapotból hibás válasz).
  lapses         Int      @default(0)
  totalReviews   Int      @default(0) @map("total_reviews")
  correctReviews Int      @default(0) @map("correct_reviews")
  /// Reakcióidő exponenciális mozgóátlaga (ms).
  avgResponseMs  Int?     @map("avg_response_ms")
  /// Felejtési görbe stabilitás-becslése (S, napokban): R(t) = exp(-t / S).
  stabilityDays  Decimal? @map("stability_days") @db.Decimal(10, 4)

  // --- Ütemezés -----------------------------------------------------------
  lastReviewedAt DateTime? @map("last_reviewed_at") @db.Timestamptz(3)
  /// A következő esedékes ismétlés időpontja. NEW állapotban NULL.
  nextReviewAt   DateTime? @map("next_review_at") @db.Timestamptz(3)
  isSuspended    Boolean   @default(false) @map("is_suspended")
  /// A felhasználói jelzők (felfüggesztés, törlés) utolsó módosításának ideje a
  /// MÓDOSÍTÓ eszköz (korrigált) órája szerint – a „last write wins” ütközés-
  /// feloldás alapja. Nem az updated_at: az a szerverre érkezés ideje, ami egy
  /// később szinkronizáló, de korábban módosító eszköznek jogtalanul nyerne.
  flagsChangedAt DateTime? @map("flags_changed_at") @db.Timestamptz(3)

  version   Int       @default(1)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz(3)

  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  word       Word        @relation(fields: [wordId], references: [id], onDelete: Cascade)
  reviewLogs ReviewLog[]

  @@unique([userId, wordId, cardType])
  /// Szinkron „pull”: a felhasználó egy időpont óta módosult kártyái.
  @@index([userId, updatedAt])
  @@index([wordId])
  // [SQL] részleges index – ESEDÉKES kártyák:
  //       (user_id, next_review_at) WHERE state <> 'NEW' AND NOT is_suspended AND deleted_at IS NULL
  // [SQL] részleges index – ÚJ kártyák:
  //       (user_id, created_at) WHERE state = 'NEW' AND NOT is_suspended AND deleted_at IS NULL
  // [SQL] CHECK: ease_factor BETWEEN 1.30 AND 5.00; nemnegatív számlálók;
  //       correct_reviews <= total_reviews; state = 'NEW' <=> next_review_at IS NULL.
  @@map("user_progress")
}

/// Append-only értékelési napló. Az `id`-t a kliens generálja, így az offline
/// felvett események feltöltése idempotens (ismételt küldés = no-op).
model ReviewLog {
  id             String   @id @db.Uuid
  userId         String   @map("user_id") @db.Uuid
  progressId     String   @map("progress_id") @db.Uuid
  /// Válaszminőség (SM-2 skála): 0 = teljes kiesés … 5 = tökéletes, azonnali.
  grade          Int      @db.SmallInt
  responseTimeMs Int      @map("response_time_ms")
  /// Az értékelés időpontja a kliens órája szerint.
  reviewedAt     DateTime @map("reviewed_at") @db.Timestamptz(3)
  /// Beérkezés a szerverre – a szinkron „pull” kurzora (monoton, szerveroldali).
  receivedAt     DateTime @default(now()) @map("received_at") @db.Timestamptz(3)
  deviceId       String?  @map("device_id") @db.VarChar(128)

  // --- Állapot az értékelés előtt és után (auditálhatóság, újrakalibrálás) ---
  stateBefore           CardState @map("state_before")
  stateAfter            CardState @map("state_after")
  easeFactorBefore      Decimal   @map("ease_factor_before") @db.Decimal(4, 2)
  easeFactorAfter       Decimal   @map("ease_factor_after") @db.Decimal(4, 2)
  intervalDaysBefore    Int       @map("interval_days_before")
  intervalDaysAfter     Int       @map("interval_days_after")
  /// Ténylegesen eltelt napok az előző ismétlés óta (felejtési görbe illesztéséhez).
  elapsedDays           Decimal?  @map("elapsed_days") @db.Decimal(10, 4)
  scheduledNextReviewAt DateTime  @map("scheduled_next_review_at") @db.Timestamptz(3)

  user     User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  progress UserProgress @relation(fields: [progressId], references: [id], onDelete: Cascade)

  @@index([progressId, reviewedAt])
  @@index([userId, reviewedAt])
  @@index([userId, receivedAt])
  // [SQL] CHECK: grade BETWEEN 0 AND 5; response_time_ms >= 0;
  //       ease_factor_* BETWEEN 1.30 AND 5.00; interval_days_* >= 0.
  // [SQL] trigger: UPDATE tiltása (append-only).
  @@map("review_logs")
}

{
  "name": "@szokartya/backend",
  "version": "0.1.0",
  "private": true,
  "description": "Szókártya – NestJS backend (REST API, PostgreSQL, adaptív ismétlésütemezés)",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "nest build",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:prod": "node dist/main.js",
    "postinstall": "prisma generate",
    "prisma:validate": "prisma validate",
    "prisma:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev --create-only",
    "db:seed": "prisma db seed",
    "db:reset": "prisma migrate reset --force",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\" \"prisma/**/*.ts\" \"scripts/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"test/**/*.ts\" \"prisma/**/*.ts\" \"scripts/**/*.ts\"",
    "db:verify": "prisma db execute --schema prisma/schema.prisma --file prisma/verify/schema-checks.sql",
    "test": "jest",
    "test:cov": "jest --coverage",
    "test:e2e": "jest --config test/jest-e2e.config.js --runInBand",
    "test:golden:update": "tsx scripts/generate-sm2-golden.ts"
  },
  "dependencies": {
    "@nestjs/common": "^11.2.7",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.2.7",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/platform-express": "^11.2.7",
    "@nestjs/schedule": "^6.1.3",
    "@nestjs/swagger": "^11.4.7",
    "@nestjs/throttler": "^6.7.1",
    "@prisma/client": "6.19.3",
    "argon2": "^0.45.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "dotenv": "^16.4.7",
    "helmet": "^8.3.0",
    "nestjs-pino": "^5.3.1",
    "pino-http": "^11.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@nestjs/cli": "^11.0.24",
    "@nestjs/testing": "^11.2.7",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.10.0",
    "@types/supertest": "^6.0.3",
    "eslint": "^9.39.5",
    "jest": "^30.5.2",
    "pino-pretty": "^13.2.0",
    "prettier": "^3.9.10",
    "prisma": "6.19.3",
    "supertest": "^7.3.1",
    "ts-jest": "^29.4.14",
    "tsx": "^4.20.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.72.0"
  }
}
